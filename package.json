{
  "name": "mekoniq-robot-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "check:source": "node scripts/check-source.mjs",
    "runtime": "node scripts/start-runtime.mjs",
    "test:runtime-e2e": "node scripts/test-runtime-e2e.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.180.0",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.12"
  }
}
