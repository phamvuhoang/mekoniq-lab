index 0000000..a01ad04
--- /dev/null
+++ b/tests/integration/lab-v2-bv01-sil.test.ts
@@ -0,0 +1,53 @@
+import {expect,test} from 'vitest';
+import {preflight} from '../../packages/lab-runtime/src/v2/sil/cli';
+test('BV01 native admission requires all three registered providers and its pinned fixture',()=>{
+ const p=preflight('BV01','coffee-simulation');expect(p.ok).toBe(true);expect([...p.required].sort()).toEqual(['coffee_io_sim','gazebo_nav2','linuxcnc_sim']);expect(p.fixture?.project).toBe('sil/bv01.json');
+});
+import {mkdtemp,rm,readFile} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join,resolve} from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {beforeAll,afterAll} from 'vitest';
+import {nativeProviderFactory} from '../../packages/lab-runtime/src/v2/sil/native-providers';
+import {createNativeScenarioRun,assertNativeAdmission} from '../../packages/lab-runtime/src/v2/sil/native-lifecycle';
+import {nativeBv01Double} from '../support/native-bv01-double';
+let directory:string,bundle:string;const root=resolve('.');
+beforeAll(async()=>{directory=await mkdtemp(join(tmpdir(),'native-bv01-'));bundle=join(directory,'bundle');const f=join(root,'tests/fixtures/digital-twin/sil/bv01.json');const r=spawnSync(join(root,'.venv/bin/python'),['-m','compiler','--fixture',f,'--scenario',f,'--out',bundle],{env:{...process.env,PYTHONPATH:join(root,'robotics/simulation')+':'+join(root,'robotics/agent')},encoding:'utf8'});if(r.status!==0)throw new Error(r.stderr);});
+afterAll(async()=>{await rm(directory,{recursive:true,force:true});});
+const config=()=>({sourceRoot:root,bundleDirectory:bundle,environmentProfile:'utm-ubuntu-arm64',arm:{socketPath:'/unused-protocol-double.sock'}});
+async function open(mode:Parameters<typeof nativeBv01Double>[1]='happy',deadlineMs=40000){const double=nativeBv01Double(root,mode),factory=await nativeProviderFactory(config(),double.transports),input={project:factory.project,scenarioId:'BV01',scenarioRevision:1,seed:23,mode:'simulation' as const,access:'simulated' as const,backendSetId:'coffee-simulation',sourceCommit:'90a5d74'},providers={directory:await mkdtemp(join(directory,'run-'))};return {run:await createNativeScenarioRun(input,providers,factory,{paceMs:2,deadlineMs}),double,factory,input,providers};}
+test('production native composition rejects incompatible project and unsupported schedules before provider effects',async()=>{
+ const d=nativeBv01Double(root),factory=await nativeProviderFactory(config(),d.transports),input={project:{...factory.project,id:'mock-only'},scenarioId:'BV01',scenarioRevision:1,seed:23,mode:'simulation' as const,access:'simulated' as const,backendSetId:'coffee-simulation',sourceCommit:'90a5d74'};
+ expect(()=>assertNativeAdmission(input,{directory},factory)).toThrow('NATIVE_FIXTURE_MISMATCH');expect(d.bridge.sends).toBe(0);
+});
+test('protocol_double production composition runs both recipes with source handoffs and never claims native proof',async()=>{
+ const {run,double}=await open();try{await run.start();let v=await run.snapshot();const end=Date.now()+39000;while(v.run.status==='running'&&Date.now()<end){await new Promise(r=>setTimeout(r,25));v=await run.snapshot();}
+ expect(v.attention).toEqual([]);const report=await run.report();expect(report.attention).toEqual([]);expect(report.outcome.status).toBe('completed');expect(report.outcome.served).toBe('2');expect(report.businessEvents.some(e=>e.type==='CargoLoaded')).toBe(true);expect(report.verification?.result).toBe('not_run');expect(report.verification?.blockers).toContain('PROTOCOL_DOUBLE');expect(report.coffee?.armTrace.samples).toEqual([]);expect(report.verification?.transfers.length).toBeGreaterThanOrEqual(6);
+ }finally{await run.close();await run.close();}expect(double.bridge.closed).toBe(1);expect(double.backendClosed).toBe(1);
+},45000);
+test('empty native samples are not pass and reopening does not acquire a lease or resend motion',async()=>{
+ const x=await open('no-samples',80);await x.run.start();await new Promise(r=>setTimeout(r,120));const report=await x.run.report();expect(report.verification?.result).toBe('not_run');expect(report.verification?.blockers).toContain('ARM_SAMPLES_MISSING');const id=x.run.id;await x.run.close();const sent=x.double.bridge.log.length;
+ const reopened=await createNativeScenarioRun(x.input,x.providers,x.factory);try{expect(reopened.id).toBe(id);expect((await reopened.snapshot()).controlAccess).toBe('view_reconcile');expect(x.double.bridge.log.length).toBe(sent);expect((await reopened.report()).manifest.runId).toBe(id);await expect(reopened.start()).rejects.toThrow();}finally{await reopened.close();}
+});
+test.each(['controller-restart','tunnel-loss'] as const)('native %s fault retains a nonterminal attention outcome and durable intent',async kind=>{
+ const d=nativeBv01Double(root,'no-samples'),factory=await nativeProviderFactory({...config(),faults:[{id:'cut-1',kind,atSimMs:0,durationMs:100}]},d.transports),input={project:factory.project,scenarioId:'BV01',scenarioRevision:1,seed:23,mode:'simulation' as const,access:'simulated' as const,backendSetId:'coffee-simulation',sourceCommit:'90a5d74'},dir=await mkdtemp(join(directory,'fault-'));
+ const run=await createNativeScenarioRun(input,{directory:dir},factory,{paceMs:2,deadlineMs:1000});try{await run.start();await new Promise(r=>setTimeout(r,80));const v=await run.snapshot();expect(v.run.status).toBe('needs_attention');expect(v.served).toBe('0');expect(JSON.parse(await readFile(join(dir,'native-faults.json'),'utf8'))[0]).toMatchObject({id:'cut-1',status:'intent'});expect((await run.report()).verification?.result).toBe('not_run');}finally{await run.close();}
+});
+test('pause refusal has no provider effects and action receipts/reconcile survive native reopen',async()=>{
+ const x=await open('no-samples');try{const v=await x.run.snapshot(),n=x.double.bridge.log.length;await expect(x.run.action({actionId:'pause-refused',expectedRevision:v.run.runRevision,kind:'pause',payload:{}})).rejects.toThrow('NATIVE_PAUSE_UNSUPPORTED');expect(x.double.bridge.log.length).toBe(n);await x.run.start();const replay=await x.run.start();expect(replay.run.status).toBe('running');}finally{await x.run.close();}
+ const reopened=await createNativeScenarioRun(x.input,x.providers,x.factory);try{const v=await reopened.snapshot();const r=await reopened.action({actionId:'read-reconcile',expectedRevision:v.run.runRevision,kind:'reconcile',payload:{subjectId:'coffee-job-1'}});expect(r.run.status).toBe('needs_attention');expect(r.controlAccess).toBe('view_reconcile');expect((await reopened.report()).reconciliations).toEqual([expect.objectContaining({subjectId:'coffee-job-1',nativeState:expect.stringContaining('journal_only:')})]);}finally{await reopened.close();}
+});
+
+test('native rejects externally managed restart and ignores no unsupported fault schedule',async()=>{
+ await expect(nativeProviderFactory({...config(),faults:[{id:'restart',kind:'controller-restart',atSimMs:0,durationMs:10}]})).rejects.toThrow('NATIVE_CONTROLLER_RESTART_REQUIRES_EXTERNAL_OPERATOR');
+ const x=await open('no-samples');try{expect(()=>assertNativeAdmission(x.input,{...x.providers,catalog:{backends:[],sets:{'coffee-simulation':{mode:'simulation',access:'simulated',backends:['gazebo_nav2']}}}},x.factory)).toThrow('BACKEND_SET_EXACT_MISMATCH');const project=structuredClone(x.input.project);project.faultSchedule=[{id:'unsupported',tick:1,kind:'cup-missing',targetId:'cup-1',durationTicks:2}] as never;expect(()=>assertNativeAdmission({...x.input,project},x.providers,x.factory)).toThrow();}finally{await x.run.close();}
+});
+test.each(['missing-cup','grip-failure','amr-disconnect','amr-delay','blocker'] as const)('native %s injection records intent and is never promoted to live proof',async kind=>{
